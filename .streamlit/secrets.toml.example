JWT_SECRET = "changeme"

# NAO declare CARTO_API_KEY aqui em producao.
#
# O Streamlit copia todo segredo deste arquivo para os.environ, sobrescrevendo
# o que ja estivesse definido. Uma CARTO_API_KEY declarada aqui passaria por
# cima da variavel de ambiente do container, e um valor vazio apagaria a chave
# injetada pelo Portainer.
#
# Em producao, defina apenas a variavel de ambiente CARTO_API_KEY.
# No dev local, exporte CARTO_API_KEY no shell antes de rodar o app.
# Sem chave nenhuma, o dashboard usa OpenStreetMap como camada base.
