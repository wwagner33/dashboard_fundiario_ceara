POSTGRES_USER=terra
POSTGRES_PASSWORD=changeme

# Segredo JWT compartilhado entre dashboard e miniserver (o mesmo valor nos dois).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Atencao: no Portainer, cole o valor sem aspas.
JWT_SECRET=

# API key dos basemaps raster da CARTO.
# Sem ela os tiles vêm com a marca d'agua "API key required".
# Obtenha a sua em https://carto.com/basemaps/apikey
# Se ficar vazia, o dashboard usa OpenStreetMap como camada base.
# A chave pode ser restrita a um dominio no painel da CARTO; fora do dominio
# liberado o CDN devolve 403 e os tiles ficam cinza.
# Atencao: no Portainer, cole o valor sem aspas.
CARTO_API_KEY=
